# ══════════════════════════════════════════════════════════
# SALA
# ══════════════════════════════════════════════════════════

type Sala {
    id: ID!
    codigo: String!
    estado: EstadoSala!
    fechaCreacion: String!
    usuario1: Usuario!
    usuario2: Usuario
}

enum EstadoSala {
    CREADA
    ESPERANDO
    ACTIVA
    FINALIZADA
    CANCELADA
}

input CrearSalaInput {
    usuarioId: ID!
}

input UnirseSalaInput {
    codigo: String!
    usuarioId: ID!
}

extend type Query {
    obtenerSala(id: ID!): Sala!
    buscarSalaPorCodigo(codigo: String!): Sala!
    obtenerEstadoSala(salaId: ID!): EstadoSalaCompleta!
}

type EstadoSalaCompleta {
    salaId: ID!
    codigo: String!
    estado: EstadoSala!
    estadosUsuarios: [EstadoConexion!]!
}

type EstadoConexion {
    usuarioId: ID!
    conectado: Boolean!
    nombreUsuario: String!
}

extend type Mutation {
    crearSala(input: CrearSalaInput!): Sala!
    unirseASala(input: UnirseSalaInput!): Sala!
    finalizarSala(id: ID!, usuarioId: ID!): Boolean!
    cancelarSala(id: ID!, usuarioId: ID!): Boolean!
}

extend type Subscription {
    cambiosSala(salaId: ID!): CambioSala!
}

type CambioSala {
    salaId: ID!
    estado: EstadoSala!
    mensaje: String!
}
