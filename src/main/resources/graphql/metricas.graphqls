# ══════════════════════════════════════════════════════════
# METRICAS (admin)
# ══════════════════════════════════════════════════════════

type Metricas {
    totalSalas: Int!
    salasActivas: Int!
    totalMatches: Int!
    promedioCalificacion: Float!
    filtroActivo: Boolean!
}

type MetricasDia {
    fecha: String!
    totalSalas: Int!
    salasActivas: Int!
    totalMatches: Int!
    promedioCalificacion: Float
}

extend type Query {
    metricas(desde: String, hasta: String): Metricas!
    historialMetricas: [MetricasDia!]!
}
