# ══════════════════════════════════════════════════════════
# USUARIO / PERFIL
# ══════════════════════════════════════════════════════════

type Usuario {
    id: ID!
    nombre: String!
    correo: String!
    descripcion: String
    rol: RolUsuario!
}

enum RolUsuario {
    USUARIO
    ADMINISTRADOR
}

input PerfilInput {
    nombre: String!
    descripcion: String!
}

extend type Query {
    obtenerPerfil(id: ID!): Usuario!
    miPerfil: Usuario!
}

extend type Mutation {
    actualizarPerfil(id: ID!, input: PerfilInput!): Usuario!
}
