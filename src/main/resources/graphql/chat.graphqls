# ══════════════════════════════════════════════════════════
# CHAT / MENSAJES
# ══════════════════════════════════════════════════════════

type Mensaje {
    id: ID!
    texto: String!
    fechaEnvio: String!
    usuarioId: ID!
    nombreUsuario: String!
}

type EstadoCompanero {
    usuarioId: ID!
    estado: String!
    nombreUsuario: String!
}

type EvaluacionRecibida {
    salaId: ID!
    usuarioId: ID!
    contenidoId: String!
    decision: Boolean!
    nombreUsuario: String!
}

input MensajeInput {
    salaId: ID!
    usuarioId: ID!
    texto: String!
}

extend type Query {
    historialChat(salaId: ID!): [Mensaje!]!
}

extend type Mutation {
    enviarMensaje(input: MensajeInput!): Mensaje!
}

extend type Subscription {
    mensajeRecibido(salaId: ID!): Mensaje!
    matchDetectado(salaId: ID!): Match!
    salaFinalizada(salaId: ID!): Boolean!
    estadoCompanero(salaId: ID!): EstadoCompanero!
    evaluacionRecibida(salaId: ID!): EvaluacionRecibida!
}
